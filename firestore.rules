rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function approved() { return signedIn() && exists(myDoc()) && get(myDoc()).data.status == 'approved'; }
    function isAdmin() { return approved() && get(myDoc()).data.role == 'admin'; }

    // Members: a user can create only their own *pending, non-admin* profile.
    // Only admins can approve/decline (change `status`).
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.role == 'member';
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    match /notes/{id} {
      allow read: if approved();
      allow create: if approved()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
                    && request.resource.data.link is string
                    && request.resource.data.link.matches('^https?://.+');
      allow delete: if approved() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /requests/{id} {
      allow read: if approved();
      allow create: if approved()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120;
      // "I need this": add yourself to voters, exactly once
      allow update: if approved()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voters'])
                    && request.resource.data.voters.size() == resource.data.voters.size() + 1
                    && request.auth.uid in request.resource.data.voters;
      allow delete: if approved() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /messages/{id} {
      allow read: if approved();
      allow create: if approved()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
      allow delete: if isAdmin();
    }
  }
}
